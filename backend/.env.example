# Copy to backend/.env and fill in. Never commit the real .env.

# --- Google Earth Engine ---
# The GCP project you linked when you registered for Earth Engine.
# Run `earthengine authenticate` once before the pipeline will work.
EE_PROJECT=project-3d5615d7-6bd8-49e5-b3f

# --- PostGIS ---
# Matches the docker command in README.md.
DATABASE_URL=postgresql+psycopg://postgres:jalniti@localhost:5432/postgres

# --- IMD live rainfall (OPTIONAL) ---
# IMD does not hand out public API keys today, so leave IMD_API_KEY empty:
# the app skips IMD and uses Open-Meteo / MET Norway instead, with no errors.
# When you do get a key, paste it here (and set the same IMD_API_KEY in the
# web app's environment) and IMD automatically becomes the preferred source.
IMD_API_BASE=https://api.imd.gov.in
IMD_API_KEY=
