# Copy to backend/.env and fill in. Never commit the real .env.

# --- Google Earth Engine ---
# The GCP project you linked when you registered for Earth Engine.
# Run `earthengine authenticate` once before the pipeline will work.
EE_PROJECT=your-gcp-project-id

# --- PostGIS ---
# Matches the docker command in README.md.
DATABASE_URL=postgresql+psycopg://postgres:jalniti@localhost:5432/postgres

# --- IMD live rainfall ---
# api.imd.gov.in endpoints are currently open (no key). If IMD starts
# requiring one, put it here rather than hardcoding it in source.
IMD_API_BASE=https://api.imd.gov.in
IMD_API_KEY=
