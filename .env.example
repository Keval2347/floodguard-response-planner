# JalNiti Web Application Environment Variables
# Copy this file to .env and fill in values as needed.
# NEVER commit your real .env file or credentials to git.

# --- India Meteorological Department (IMD) Live Rainfall (OPTIONAL) ---
# IMD does not issue public API keys today; if empty or unset, the application automatically falls back to Open-Meteo and MET Norway with no error.
# If you have an authorized IMD API key, provide it here to use IMD as preferred source.
IMD_API_KEY=
IMD_API_BASE=https://api.imd.gov.in

# --- Server / Runtime Configuration ---
# PORT=5173
# NODE_ENV=development
